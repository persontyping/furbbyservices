# Secrets for the `send-contact-email` Supabase Edge Function.
# Set these with: supabase secrets set --env-file supabase/functions/.env.example
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-ses-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-ses-iam-secret-access-key
SES_FROM_EMAIL=verified-sender@example.com
SES_TO_EMAIL=inbox@example.com
# Provided automatically in deployed Edge Functions; set manually for local `supabase functions serve`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
